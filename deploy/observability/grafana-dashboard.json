      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le, protocol) (rate(molcajeted_frame_flush_seconds_bucket{protocol=~\"$protocol\"}[$__rate_interval])))",
