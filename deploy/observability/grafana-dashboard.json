    {
      "type": "timeseries",
      "title": "Frame build time",
      "description": "Distribution of one Display::flush. When this is high, server CPU is the bottleneck",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 9,
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le, protocol) (rate(molcajeted_frame_flush_seconds_bucket{protocol=~\"$protocol\"}[$__rate_interval])))",
          "legendFormat": "p50 {{protocol}}",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, protocol) (rate(molcajeted_frame_flush_seconds_bucket{protocol=~\"$protocol\"}[$__rate_interval])))",
          "legendFormat": "p95 {{protocol}}",
          "range": true,
          "instant": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le, protocol) (rate(molcajeted_frame_flush_seconds_bucket{protocol=~\"$protocol\"}[$__rate_interval])))",
          "legendFormat": "p99 {{protocol}}",
          "range": true,
          "instant": false,
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
