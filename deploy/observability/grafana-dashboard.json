      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{namespace=\"molcajete\", container=\"molcajeted\"} |= \"display summary\" | json | line_format `{{.span_id}} {{.protocol}} {{printf \"%.0f\" (float64 .duration_s)}}s frames={{.frames}} fps={{printf \"%.1f\" (float64 .fps_avg)}} | flush avg/max={{printf \"%.1f\" (float64 .flush_ms_avg)}}/{{printf \"%.1f\" (float64 .flush_ms_max)}}ms | ack avg/max={{printf \"%.1f\" (float64 .client_ack_ms_avg)}}/{{printf \"%.1f\" (float64 .client_ack_ms_max)}}ms | png={{.png_images}} ({{printf \"%.2f\" (float64 .png_ms_avg)}}ms) jpeg={{.jpeg_images}} ({{printf \"%.2f\" (float64 .jpeg_ms_avg)}}ms) video={{.video_frames}} ({{printf \"%.1f\" (float64 .video_encode_ms_avg)}}ms)`",
          "queryType": "range",
          "refId": "A"
        }
