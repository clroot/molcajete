          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(molcajeted_frame_flush_seconds_bucket{protocol=~\"$protocol\"}[$__rate_interval])))",
          "legendFormat": "",
          "range": true,
          "instant": false,
